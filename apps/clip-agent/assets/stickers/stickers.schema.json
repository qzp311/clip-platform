{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "StickerManifest",
  "type": "object",
  "required": ["version", "templates"],
  "properties": {
    "version": { "type": "string" },
    "description": { "type": "string" },
    "categories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "tags": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "templates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "type", "file"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "type": { "enum": ["image", "video"] },
          "file": { "type": "string" },
          "categories": { "type": "array", "items": { "type": "string" } },
          "tags": { "type": "array", "items": { "type": "string" } },
          "defaultPosition": { "type": "string" },
          "defaultScale": { "type": "number", "minimum": 0.01, "maximum": 10 },
          "durationSec": { "type": "number", "minimum": 0.1 },
          "loop": { "type": "boolean" },
          "textPlaceholder": { "type": ["string", "null"] },
          "license": { "type": "string" },
          "licenseScope": { "type": "string" }
        }
      }
    }
  }
}
